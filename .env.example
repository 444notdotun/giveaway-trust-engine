POSTGRES_DB=giveaway
DB_HOST=localhost
DB_PORT=5433
POSTGRES_USER=giveaway
POSTGRES_PASSWORD=.....
REDIS_PORT=6380
REDIS_HOST=localhost

# Startup guard (slice 2). Base URLs confirmed directly by Adedotun, not guessed.
# Webhook signature/retry/response-code details are still unverified, pending the
# Bachs sandbox check in slice 10.
APP_ENVIRONMENT=DEV
BACHS_SANDBOX_BASE_URL=https://sandbox-api.bachs.io
BACHS_LIVE_BASE_URL=https://api.bachs.io
BACHS_BASE_URL=https://sandbox-api.bachs.io

# Slice 3 (Auth). Redis password/TLS are empty for local dev's unauthenticated,
# non-TLS Redis container; staging's real values are Upstash's (mandatory there).
# No startup-guard enforcement exists yet for these -- GREEN still needs to extend
# the same isUnset rule (missing, blank, or containing "${") from the slice 2 guard
# to every one of these, naming whichever property is actually missing.
REDIS_PASSWORD=
REDIS_TLS_ENABLED=
JWT_SIGNING_KEY=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=