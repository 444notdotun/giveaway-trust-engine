POSTGRES_DB=giveaway
DB_HOST=localhost
DB_PORT=5433
POSTGRES_USER=giveaway
POSTGRES_PASSWORD=.....
REDIS_PORT=6380
REDIS_HOST=localhost

# Startup guard (slice 2). Base URLs confirmed directly by Adedotun, not guessed.
# Webhook signature/retry/response-code details are still unverified, pending the
# Bachs sandbox check in slice 10.
APP_ENVIRONMENT=DEV
BACHS_SANDBOX_BASE_URL=https://sandbox-api.bachs.io
BACHS_LIVE_BASE_URL=https://api.bachs.io
BACHS_BASE_URL=https://sandbox-api.bachs.io

# Slice 3 (Auth). StartupGuardBeanFactoryPostProcessor (chunk 4 review, item 3) now enforces
# the same isUnset rule (missing, blank, or containing "${") on X_OAUTH_CLIENT_ID,
# X_OAUTH_CLIENT_SECRET, X_OAUTH_REDIRECT_URI, and REDIS_PASSWORD in every environment --
# none of these may be left blank, including local dev. REDIS_TLS_ENABLED is additionally
# required to be the EXACT string "true" (no trim, no case change) in STAGING and PRODUCTION
# only -- Upstash (staging/production's real Redis) mandates TLS; DEV's local Redis container
# does not.
REDIS_PASSWORD=
REDIS_TLS_ENABLED=
JWT_SIGNING_KEY=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=